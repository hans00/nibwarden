// Building blocks for nibwarden windows: own components instead of the std widgets, so
// every window has the same look on every desktop.
import { Theme } from "theme.slint";

// Stroke icons on a 24×24 grid (paths after Lucide, ISC licence).
export component Icon inherits Path {
    in property <color> color: Theme.text-muted;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    stroke: color;
    stroke-width: 1.8px;
    fill: transparent;
}

