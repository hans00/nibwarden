// Settings (phase2.md §5.6). Every change is saved right away to config.toml and the
// daemon is asked to reload it; there is no Save button.
import { Theme } from "theme.slint";
import { Button, PasswordField, ScrollBar, Segmented, Switch, TitleBar, WindowCard } from "components.slint";
import { Picker } from "editor.slint";

component Section inherits VerticalLayout {
    in property <string> title;
    spacing: 8px;
    Text {
        text: root.title;
        color: Theme.text-muted;
        font-size: Theme.font-small;
        font-weight: 700;
    }
    Rectangle {
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            @children
        }
    }
}

// One setting: a label (with an optional explanation) and its control on the right.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    // The detail says why something failed.
    in property <bool> failed;
    in property <bool> first;
    min-height: 56px;
    if !root.first: Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-body + 0.5px;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                color: root.failed ? Theme.danger : Theme.text-muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            VerticalLayout {
                alignment: center;
                @children
            }
        }
    }
}

// A keyboard shortcut: shows it; clicked, records the next key combination (Esc cancels,
// Backspace clears).
component ShortcutField inherits Rectangle {
    // As shown, e.g. "Ctrl+Shift+Space"; empty when there is none.
    in property <string> shortcut;
    in-out property <bool> recording;
    // A key with its modifiers; `true` if it makes a shortcut (recording then ends).
    callback pressed(string, bool, bool, bool, bool) -> bool;
    callback cleared();
    width: 200px;
    height: 34px;
    border-radius: Theme.radius-sm + 1px;
    background: root.recording ? Theme.accent-soft : touch.has-hover ? Theme.surface-muted : Theme.surface;
    border-width: root.recording ? 2px : 1px;
    border-color: root.recording ? Theme.accent : Theme.border-strong;
    accessible-role: button;
    accessible-label: @tr("Keyboard shortcut");
    accessible-value: root.shortcut;
    Text {
        text: root.recording ? @tr("Press keys…") : root.shortcut != "" ? root.shortcut : @tr("None");
        color: root.recording || root.shortcut == "" ? Theme.text-muted : Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.recording = true;
            keys.focus();
        }
    }
    keys := FocusScope {
        enabled: root.recording;
        focus-changed-event => {
            if !self.has-focus {
                root.recording = false;
            }
        }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.recording = false;
                return accept;
            }
            if event.text == Key.Backspace || event.text == Key.Delete {
                root.recording = false;
                root.cleared();
                return accept;
            }
            if root.pressed(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta) {
                root.recording = false;
            }
            accept
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("nibwarden settings");
    no-frame: true;
    width: 640px + 2 * Theme.window-margin;
    height: 700px + 2 * Theme.window-margin;
    // Transparent: the visible window is the rounded card inside (WindowCard).
    background: transparent;

    // Index of the chosen option in each Segmented below.
    in-out property <int> theme;
    in-out property <int> language;
    in-out property <int> idle;
    in-out property <bool> lock-on-screen-lock;
    in-out property <bool> lock-on-sleep;
    in-out property <bool> clear-clipboard;
    in-out property <int> clear-after;
    in-out property <bool> ask-read;
    in-out property <int> remember;
    in-out property <int> remember-for;
    in-out property <bool> allow-without-window;
    in-out property <bool> tray;
    in-out property <bool> start-at-login;
    in-out property <bool> website-icons;
    // Unlocking without the master password: with the system's authentication, and with
    // a PIN (`pin-entry`: the PIN is being typed).
    in-out property <bool> system-unlock;
    in-out property <bool> system-unlock-failed;
    in-out property <bool> pin-unlock;
    in-out property <bool> pin-entry;
    in-out property <string> pin-text;
    in-out property <bool> pin-failed;
    // After the inactivity timeout: 0 lock, 1 sign out.
    in-out property <int> idle-action;
    in-out property <bool> minimize-after-copy;
    // The browser extension unlocks with nibwarden; `browser-others`: the browsers where
    // another program (Bitwarden's desktop app) is registered instead.
    in-out property <bool> browser;
    in property <string> browser-others;
    // ssh uses nibwarden's agent; `ssh-other-agent`: an IdentityAgent of the user's own in
    // ~/.ssh/config, which still applies to its hosts.
    in-out property <bool> ssh-agent;
    in property <string> ssh-other-agent;
    // Turning a setting on failed because another one takes precedence; the switch stays
    // off. The conflicting value (ssh) or setting (git), for the record.
    in-out property <string> ssh-failed;
    in-out property <string> git-failed;
    // git signs commits with the vault key `ssh-keys[signing-key]`.
    in-out property <bool> git-signing;
    in property <[string]> ssh-keys;
    in-out property <int> signing-key;
    in property <string> shortcut-status;
    // Quick access's shortcut as shown ("Ctrl+Shift+Space"); whether nibwarden can set it on
    // this desktop.
    in property <string> shortcut;
    in property <bool> shortcut-supported;
    // Problems saving, shown at the bottom.
    in property <string> error;

    callback theme-chosen(int);
    callback language-chosen(int);
    callback idle-chosen(int);
    callback lock-on-screen-lock-changed(bool);
    callback lock-on-sleep-changed(bool);
    callback clear-clipboard-changed(bool);
    callback clear-after-chosen(int);
    callback ask-read-changed(bool);
    callback remember-chosen(int);
    callback remember-for-chosen(int);
    callback allow-without-window-changed(bool);
    callback shortcut-pressed(string, bool, bool, bool, bool) -> bool;
    callback shortcut-cleared();
    callback tray-changed(bool);
    callback start-at-login-changed(bool);
    callback website-icons-changed(bool);
    callback system-unlock-changed(bool);
    callback pin-unlock-changed(bool);
    callback pin-submitted();
    callback idle-action-chosen(int);
    callback minimize-after-copy-changed(bool);
    callback browser-changed(bool);
    callback ssh-agent-changed(bool);
    callback git-signing-changed(bool);
    callback signing-key-chosen(int);
    callback close-requested();


    WindowCard {
        x: Theme.window-margin;
        y: Theme.window-margin;
        width: root.width - 2 * Theme.window-margin;
        height: root.height - 2 * Theme.window-margin;
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.close-requested();
                    return accept;
                }
                reject
            }
            VerticalLayout {
                TitleBar {
                    title: @tr("nibwarden settings");
                    close => {
                        root.close-requested();
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    scroll := Flickable {
                        width: 100%;
                        height: 100%;
                        content-height: page.preferred-height;
                        page := VerticalLayout {
                            padding: 22px;
                            padding-top: 6px;
                            spacing: 22px;

                            Text {
                                text: @tr("Settings");
                                color: Theme.text;
                                font-size: Theme.font-title + 3px;
                                font-weight: 700;
                            }

                            Section {
                                title: @tr("Appearance");
                                SettingRow {
                                    first: true;
                                    label: @tr("Theme");
                                    Segmented {
                                        options: [@tr("System"), @tr("Light"), @tr("Dark")];
                                        selected <=> root.theme;
                                        chosen(index) => {
                                            root.theme-chosen(index);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Language");
                                    // Language names in their own language, as is customary.
                                    Segmented {
                                        options: [@tr("System"), "English", "正體中文", "简体中文"];
                                        selected <=> root.language;
                                        chosen(index) => {
                                            root.language-chosen(index);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Show website icons");
                                    Switch {
                                        label: @tr("Show website icons");
                                        checked <=> root.website-icons;
                                        toggled(on) => {
                                            root.website-icons-changed(on);
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Startup");
                                SettingRow {
                                    first: true;
                                    label: @tr("Start nibwarden at login");
                                    Switch {
                                        label: @tr("Start nibwarden at login");
                                        checked <=> root.start-at-login;
                                        toggled(on) => {
                                            root.start-at-login-changed(on);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Show in the system tray");
                                    Switch {
                                        label: @tr("Show in the system tray");
                                        checked <=> root.tray;
                                        toggled(on) => {
                                            root.tray-changed(on);
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Locking");
                                SettingRow {
                                    first: true;
                                    label: @tr("Lock after inactivity");
                                    Segmented {
                                        options: [@tr("1 min"), @tr("5 min"), @tr("15 min"), @tr("30 min"), @tr("1 hour"), @tr("Never")];
                                        selected <=> root.idle;
                                        chosen(index) => {
                                            root.idle-chosen(index);
                                        }
                                    }
                                }
                                if root.idle != 5: SettingRow {
                                    label: @tr("Timeout action");
                                    Segmented {
                                        options: [@tr("Lock"), @tr("Sign out")];
                                        selected <=> root.idle-action;
                                        chosen(index) => {
                                            root.idle-action-chosen(index);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Lock when the screen locks");
                                    Switch {
                                        label: @tr("Lock when the screen locks");
                                        checked <=> root.lock-on-screen-lock;
                                        toggled(on) => {
                                            root.lock-on-screen-lock-changed(on);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Lock before the computer sleeps");
                                    Switch {
                                        label: @tr("Lock before the computer sleeps");
                                        checked <=> root.lock-on-sleep;
                                        toggled(on) => {
                                            root.lock-on-sleep-changed(on);
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Unlock");
                                SettingRow {
                                    first: true;
                                    label: @tr("Unlock with system authentication");
                                    failed: root.system-unlock-failed;
                                    detail: root.system-unlock-failed ? @tr("Could not turn it on: the system authentication rule is not installed.") : "";
                                    Switch {
                                        label: @tr("Unlock with system authentication");
                                        checked <=> root.system-unlock;
                                        toggled(on) => {
                                            root.system-unlock-changed(on);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Unlock with a PIN");
                                    failed: root.pin-failed;
                                    detail: root.pin-failed ? @tr("Could not set the PIN.") : "";
                                    Switch {
                                        label: @tr("Unlock with a PIN");
                                        checked <=> root.pin-unlock;
                                        toggled(on) => {
                                            root.pin-unlock-changed(on);
                                        }
                                    }
                                }
                                if root.pin-entry: SettingRow {
                                    label: @tr("New PIN");
                                    PasswordField {
                                        width: 220px;
                                        placeholder: @tr("PIN");
                                        text <=> root.pin-text;
                                        accepted => {
                                            root.pin-submitted();
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Clipboard");
                                SettingRow {
                                    first: true;
                                    label: @tr("Clear copied passwords and codes");
                                    Switch {
                                        label: @tr("Clear copied passwords and codes");
                                        checked <=> root.clear-clipboard;
                                        toggled(on) => {
                                            root.clear-clipboard-changed(on);
                                        }
                                    }
                                }
                                if root.clear-clipboard: SettingRow {
                                    label: @tr("Clear after");
                                    Segmented {
                                        options: [@tr("30 s"), @tr("1 min"), @tr("90 s"), @tr("2 min"), @tr("5 min")];
                                        selected <=> root.clear-after;
                                        chosen(index) => {
                                            root.clear-after-chosen(index);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Minimize the window after copying");
                                    Switch {
                                        label: @tr("Minimize the window after copying");
                                        checked <=> root.minimize-after-copy;
                                        toggled(on) => {
                                            root.minimize-after-copy-changed(on);
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Confirmation");
                                SettingRow {
                                    first: true;
                                    label: @tr("An approval applies to");
                                    Segmented {
                                        options: [@tr("One request"), @tr("Per application"), @tr("Per terminal tab")];
                                        selected <=> root.remember;
                                        chosen(index) => {
                                            root.remember-chosen(index);
                                        }
                                    }
                                }
                                if root.remember != 0: SettingRow {
                                    label: @tr("Remember an approval");
                                    Segmented {
                                        options: [@tr("Until locked"), @tr("1 hour"), @tr("4 hours"), @tr("12 hours")];
                                        selected <=> root.remember-for;
                                        chosen(index) => {
                                            root.remember-for-chosen(index);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Ask before programs read secrets");
                                    Switch {
                                        label: @tr("Ask before programs read secrets");
                                        checked <=> root.ask-read;
                                        toggled(on) => {
                                            root.ask-read-changed(on);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Allow secret reads when no window can be shown");
                                    detail: @tr("For example over SSH.");
                                    Switch {
                                        label: @tr("Allow secret reads when no window can be shown");
                                        checked <=> root.allow-without-window;
                                        toggled(on) => {
                                            root.allow-without-window-changed(on);
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Quick access");
                                SettingRow {
                                    first: true;
                                    label: @tr("Keyboard shortcut");
                                    failed: root.shortcut-status != "";
                                    detail: root.shortcut-status != "" ? root.shortcut-status
                                        : root.shortcut-supported ? "" : @tr("Set it in the desktop's keyboard settings, to run: nibwarden-gui quick");
                                    if root.shortcut-supported: ShortcutField {
                                        shortcut: root.shortcut;
                                        pressed(text, control, alt, shift, meta) => {
                                            root.shortcut-pressed(text, control, alt, shift, meta)
                                        }
                                        cleared => {
                                            root.shortcut-cleared();
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("SSH and Git");
                                SettingRow {
                                    first: true;
                                    label: @tr("Use the SSH agent");
                                    failed: root.ssh-failed != "";
                                    detail: root.ssh-failed != "" ? @tr("Could not turn it on: conflicting setting in ~/.ssh/config.")
                                        : root.ssh-agent && root.ssh-other-agent != "" ? @tr("Hosts with their own IdentityAgent in ~/.ssh/config keep it.") : "";
                                    Switch {
                                        label: @tr("Use the SSH agent");
                                        checked <=> root.ssh-agent;
                                        toggled(on) => {
                                            root.ssh-agent-changed(on);
                                        }
                                    }
                                }
                                SettingRow {
                                    label: @tr("Sign git commits with an SSH key");
                                    failed: root.git-failed != "";
                                    detail: root.git-failed != "" ? @tr("Could not turn it on: conflicting git setting.") : "";
                                    Switch {
                                        label: @tr("Sign git commits with an SSH key");
                                        checked <=> root.git-signing;
                                        toggled(on) => {
                                            root.git-signing-changed(on);
                                        }
                                    }
                                }
                                if root.git-signing && root.ssh-keys.length > 1: SettingRow {
                                    label: @tr("Signing key");
                                    Picker {
                                        width: 240px;
                                        options: root.ssh-keys;
                                        current: root.signing-key;
                                        chosen(index) => {
                                            root.signing-key-chosen(index);
                                        }
                                    }
                                }
                            }

                            Section {
                                title: @tr("Browser");
                                SettingRow {
                                    first: true;
                                    label: @tr("Unlock the Bitwarden browser extension with nibwarden");
                                    detail: root.browser-others == "" ? "" : @tr("{0} starts Bitwarden's desktop app instead.", root.browser-others);
                                    Switch {
                                        label: @tr("Unlock the Bitwarden browser extension with nibwarden");
                                        checked <=> root.browser;
                                        toggled(on) => {
                                            root.browser-changed(on);
                                        }
                                    }
                                }
                            }

                            if root.error != "": Text {
                                text: root.error;
                                color: Theme.danger;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }
                    ScrollBar {
                        x: parent.width - self.width;
                        height: parent.height;
                        content: scroll.content-height;
                        view: scroll.height;
                        offset <=> scroll.content-y;
                    }
                }
            }
        }
    }
}
