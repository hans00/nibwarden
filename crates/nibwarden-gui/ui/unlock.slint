// Unlock window (phase2.md §5.3) in three modes: unlock only; unlock and allow one
// request; and the master password again for an item that asks for it (reprompt). The
// password lives in `password` only until the Rust side reads it on submit and clears it.
import { Theme } from "theme.slint";
import { AccessCard, ActionKind, ApprovalOptions, ApprovalScope, AppMark, Avatar, Button, Checkbox, Icon, Icons, PasswordField, PurposeKind, RequesterCard, Spinner, TitleBar, WindowCard } from "components.slint";

export enum UnlockError { none, wrong-password, wrong-pin, pin-suspended, not-confirmed }
export enum UnlockMode { unlock, unlock-allow, reprompt }

export component UnlockWindow inherits Window {
    title: mode == UnlockMode.reprompt ? @tr("Confirm with master password") : @tr("Unlock nibwarden");
    no-frame: true;
    width: 420px + 2 * Theme.window-margin;
    height: frame.preferred-height + 2 * Theme.window-margin;
    // For headless snapshots, which have no window manager to size the window.
    out property <length> natural-height: frame.preferred-height + 2 * Theme.window-margin;
    // Transparent: the visible window is the rounded card inside (WindowCard).
    background: transparent;
    forward-focus: field;

    in property <UnlockMode> mode;
    in property <string> email;
    in property <string> initial;
    // The first program waiting for the vault, and how many more there are.
    in property <string> requester;
    in property <string> requester-detail;
    in property <int> more-waiting;
    // The request shown in unlock-allow and reprompt modes.
    in property <ActionKind> action;
    in property <string> target;
    in property <string> field-name;
    in property <PurposeKind> purpose;
    in property <string> purpose-arg;
    // Offer "don't ask again for N minutes" (unlock-allow); 0 = no.
    // How long allowing lasts (unlock-allow), and the application the request runs in.
    in property <ApprovalScope> scope;
    in property <string> app;
    in-out property <bool> all-applications;
    in property <UnlockError> error;
    property <string> error-text: error == UnlockError.wrong-password ? @tr("Wrong master password.")
        : error == UnlockError.wrong-pin ? @tr("Wrong PIN.")
        : error == UnlockError.pin-suspended ? @tr("Too many wrong PINs. Enter the master password.")
        : error == UnlockError.not-confirmed ? @tr("Not confirmed.")
        : "";
    // Unlocking without the master password, where that works now; `use-pin`: the field
    // takes the PIN.
    in property <bool> pin-available;
    in property <bool> system-available;
    in-out property <bool> use-pin;
    callback system();
    in property <bool> busy;
    in-out property <string> password;

    callback submit();
    callback cancel();


    // Escape cancels from anywhere in the window.
    WindowCard {
        x: Theme.window-margin;
        y: Theme.window-margin;
        width: root.width - 2 * Theme.window-margin;
        height: root.height - 2 * Theme.window-margin;
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.cancel();
                    return accept;
                }
                reject
            }

          frame := VerticalLayout {
            TitleBar {
                title: "nibwarden";
                close => {
                    root.cancel();
                }
            }
            content := VerticalLayout {
                padding: 28px;
                padding-top: 8px;
                spacing: 0px;

                HorizontalLayout {
                    alignment: center;
                    AppMark { }
                }
                Rectangle { height: 18px; }
                Text {
                    text: root.mode == UnlockMode.unlock ? @tr("Unlock nibwarden")
                        : root.mode == UnlockMode.unlock-allow ? @tr("Unlock to allow")
                        : @tr("Confirm with master password");
                    horizontal-alignment: center;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Avatar {
                        initial: root.initial;
                        width: 20px;
                        height: 20px;
                    }
                    Text {
                        text: root.email;
                        color: Theme.text-muted;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 22px; }

                if root.mode == UnlockMode.unlock && root.requester != "": VerticalLayout {
                    spacing: 0px;
                    RequesterCard {
                        name: root.requester;
                        detail: root.requester-detail;
                    }
                    if root.more-waiting > 0: Text {
                        height: 26px;
                        vertical-alignment: center;
                        text: @tr("and {n} more program" | "and {n} more programs" % root.more-waiting);
                        color: Theme.text-muted;
                        font-size: Theme.font-small;
                        horizontal-alignment: center;
                    }
                    Rectangle { height: 16px; }
                }
                if root.mode != UnlockMode.unlock: VerticalLayout {
                    spacing: 0px;
                    AccessCard {
                        name: root.requester;
                        detail: root.requester-detail;
                        action: root.action;
                        target: root.target;
                        field: root.field-name;
                        purpose: root.purpose;
                        purpose-arg: root.purpose-arg;
                    }
                    Rectangle { height: 16px; }
                }

                field := PasswordField {
                    placeholder: root.use-pin ? @tr("PIN") : @tr("Master password");
                    text <=> root.password;
                    enabled: !root.busy;
                    busy: root.busy;
                    error: root.error != UnlockError.none;
                    accepted => {
                        root.submit();
                    }
                }

                Rectangle {
                    height: root.error != UnlockError.none ? 28px : 10px;
                    animate height { duration: 120ms; }
                    if root.error != UnlockError.none: HorizontalLayout {
                        y: 8px;
                        height: 18px;
                        spacing: 6px;
                        Icon {
                            width: 15px;
                            height: 15px;
                            commands: Icons.alert;
                            color: Theme.danger;
                        }
                        Text {
                            text: root.error-text;
                            color: Theme.danger;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                }
                if (root.pin-available || root.system-available) && root.mode != UnlockMode.reprompt: HorizontalLayout {
                    padding-bottom: 8px;
                    spacing: 10px;
                    if root.system-available: Button {
                        horizontal-stretch: 1;
                        text: @tr("Use system authentication");
                        enabled: !root.busy;
                        clicked => {
                            root.system();
                        }
                    }
                    if root.pin-available: Button {
                        horizontal-stretch: 1;
                        text: root.use-pin ? @tr("Use master password") : @tr("Use PIN");
                        enabled: !root.busy;
                        clicked => {
                            root.use-pin = !root.use-pin;
                            root.password = "";
                            field.focus();
                        }
                    }
                }
                if root.mode == UnlockMode.unlock-allow: ApprovalOptions {
                    padding-top: 4px;
                    padding-bottom: 6px;
                    scope: root.scope;
                    app: root.app;
                    all-applications <=> root.all-applications;
                }
                Rectangle { height: 14px; }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.mode == UnlockMode.unlock-allow ? @tr("Unlocking allows this request")
                            : root.mode == UnlockMode.reprompt ? @tr("This item asks for your master password")
                            : @tr("Press Enter to unlock");
                        color: Theme.text-faint;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.cancel();
                        }
                    }
                }
            }
          }
        }
    }
}
