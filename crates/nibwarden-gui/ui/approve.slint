// Confirmation for one request on the unlocked vault (phase2.md §5.3). Deny is the safe
// default: Enter and Escape deny, allowing takes a click (or the accessible action).
import { Theme } from "theme.slint";
import { AccessCard, ActionKind, ApprovalOptions, ApprovalScope, AppMark, Button, Checkbox, PurposeKind, TitleBar, WindowCard } from "components.slint";

export component ApproveWindow inherits Window {
    title: @tr("Allow access?");
    no-frame: true;
    width: 420px + 2 * Theme.window-margin;
    height: frame.preferred-height + 2 * Theme.window-margin;
    out property <length> natural-height: frame.preferred-height + 2 * Theme.window-margin;
    // Transparent: the visible window is the rounded card inside (WindowCard).
    background: transparent;
    forward-focus: keys;

    in property <string> requester;
    in property <string> requester-detail;
    in property <ActionKind> action;
    in property <string> target;
    in property <string> field-name;
    in property <PurposeKind> purpose;
    in property <string> purpose-arg;
    in property <ApprovalScope> scope;
    in property <string> app;
    in-out property <bool> all-applications;

    callback allow();
    callback deny();


    WindowCard {
        x: Theme.window-margin;
        y: Theme.window-margin;
        width: root.width - 2 * Theme.window-margin;
        height: root.height - 2 * Theme.window-margin;
        keys := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape || event.text == Key.Return) {
                    root.deny();
                    return accept;
                }
                reject
            }

          frame := VerticalLayout {
            TitleBar {
                title: "nibwarden";
                close => {
                    root.deny();
                }
            }
            content := VerticalLayout {
                padding: 28px;
                padding-top: 8px;
                spacing: 0px;

                HorizontalLayout {
                    alignment: center;
                    AppMark { }
                }
                Rectangle { height: 18px; }
                Text {
                    text: @tr("Allow access?");
                    horizontal-alignment: center;
                    color: Theme.text;
                    font-size: Theme.font-title;
                    font-weight: 700;
                }
                Rectangle { height: 22px; }
                AccessCard {
                    name: root.requester;
                    detail: root.requester-detail;
                    action: root.action;
                    target: root.target;
                    field: root.field-name;
                    purpose: root.purpose;
                    purpose-arg: root.purpose-arg;
                }
                // Only reading secrets and signing can be remembered; changes, Sends,
                // export and import are asked about every time.
                if root.action == ActionKind.ssh-sign || root.action == ActionKind.read-secret: ApprovalOptions {
                    padding-top: 16px;
                    scope: root.scope;
                    app: root.app;
                    all-applications <=> root.all-applications;
                }
                Rectangle { height: 24px; }
                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: @tr("Only allow programs you started");
                        color: Theme.text-faint;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    Button {
                        text: @tr("Deny");
                        clicked => {
                            root.deny();
                        }
                    }
                    Button {
                        text: @tr("Allow");
                        primary: true;
                        clicked => {
                            root.allow();
                        }
                    }
                }
            }
          }
        }
    }
}
